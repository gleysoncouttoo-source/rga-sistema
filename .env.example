DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"
SESSION_DAYS=7
# Opcional: cria o primeiro login automaticamente
# ADMIN_EMAIL=
# ADMIN_SENHA=
# Chave que o site de vendas usa para mandar pedidos para /api/pedidos (invente uma senha longa)
# SITE_API_TOKEN=

# Shopee (ligação automática) — dados do app aprovado na Shopee Open Platform
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_AMBIENTE=producao   # ou teste (sandbox da Shopee)
# Senha que a Vercel usa para chamar a conferência diária (/api/shopee/sincronizar)
# CRON_SECRET=

# Envio do comprovante de pagamento (Financeiro → Histórico de pagamentos). Sem isso, a tela abre o WhatsApp/e-mail para enviar à mão.
# E-mail pelo Resend (resend.com): chave da API e remetente de um domínio verificado, ex.: "R.G.A <financeiro@seudominio.com.br>"
# RESEND_API_KEY=
# EMAIL_REMETENTE=
# WhatsApp oficial (Meta / WhatsApp Business Platform): token permanente, ID do número e nome do modelo aprovado
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=
# Modelo aprovado da cotação (corpo com {{1}} = nome do contato e {{2}} = lista de itens), ex.: cotacao_semanal
# WHATSAPP_MODELO_COTACAO=
# Para receber as respostas: endereço do webhook na Meta = https://SEU-DOMINIO/api/whatsapp
# WHATSAPP_VERIFY_TOKEN=     (invente uma senha; a mesma vai no app da Meta)
# WHATSAPP_APP_SECRET=       (Chave secreta do app da Meta: confere que o aviso veio mesmo da Meta)

# Inteligência do bot (Claude API, console.anthropic.com): conversa natural e leitura dos preços
# ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# Entender áudios que chegam (serviço de transcrição no padrão OpenAI: OpenAI Whisper ou Groq)
# TRANSCRICAO_API_KEY=
# TRANSCRICAO_URL=https://api.openai.com/v1        (Groq: https://api.groq.com/openai/v1)
# TRANSCRICAO_MODELO=whisper-1                      (Groq: whisper-large-v3-turbo)
