DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"
SESSION_DAYS=7
# Opcional: cria o primeiro login automaticamente
# ADMIN_EMAIL=
# ADMIN_SENHA=
# Chave que o site de vendas usa para mandar pedidos para /api/pedidos (invente uma senha longa)
# SITE_API_TOKEN=

# Shopee (ligação automática) — dados do app aprovado na Shopee Open Platform
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_AMBIENTE=producao   # ou teste (sandbox da Shopee)
# Senha que a Vercel usa para chamar a conferência diária (/api/shopee/sincronizar)
# CRON_SECRET=

# Envio do comprovante de pagamento (Financeiro → Histórico de pagamentos). Sem isso, a tela abre o WhatsApp/e-mail para enviar à mão.
# E-mail pelo Resend (resend.com): chave da API e remetente de um domínio verificado, ex.: "R.G.A <financeiro@seudominio.com.br>"
# RESEND_API_KEY=
# EMAIL_REMETENTE=
# WhatsApp oficial (Meta / WhatsApp Business Platform): token permanente, ID do número e nome do modelo aprovado
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=
